# Copy to .env and change the values. .env is git-ignored.
# Long random string used to sign JWTs (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated username:password pairs
AUTH_USERS=admin@financepower.com:ChangeMe123
